# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vara?retryWrites=true&w=majority
AUTH_SECRET=replace-with-a-long-random-secret

# Razorpay (test mode first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: separate Express admin backend base URL (if used)
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:5000

# Single Super Admin seed (used only by npm run seed:admin; do not commit real values)
# Only one Super Admin account is allowed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_NAME=Super Admin
