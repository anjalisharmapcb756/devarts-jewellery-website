# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vara?retryWrites=true&w=majority

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth
ADMIN_JWT_SECRET='"secret key"'

# Razorpay (server-side only; leave empty to use Cash on Delivery only)
# Use test keys first: rzp_test_... / corresponding secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Single Super Admin seed (used only by npm run seed; do not commit real values)
# Only one Super Admin account is allowed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-password
